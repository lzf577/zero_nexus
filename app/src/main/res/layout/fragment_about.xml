<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/dashboard_bg">

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_behavior="@string/appbar_scrolling_view_behavior"
        android:padding="24dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_horizontal"
        android:orientation="vertical">

        <!-- Header: Logo & Title -->
        <ImageView
            android:id="@+id/about_logo"
            android:layout_width="64dp"
            android:layout_height="64dp"
            android:layout_marginBottom="12dp"
            android:src="@mipmap/ic_launcher" />

        <TextView
            android:id="@+id/about_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif-medium"
            android:text="@string/about_title"
            android:textColor="@color/dashboard_text_main"
            android:textSize="22sp"
            android:textStyle="bold" />

        <!-- Version Information -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="24dp"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/about_kernel_version"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/dashboard_text_sub"
                android:textSize="12sp"
                tools:text="Kernel: 1.16.2" />

            <View
                android:layout_width="1dp"
                android:layout_height="10dp"
                android:layout_gravity="center_vertical"
                android:layout_marginStart="8dp"
                android:layout_marginEnd="8dp"
                android:background="@color/dashboard_text_sub" />

            <TextView
                android:id="@+id/about_app_version"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/dashboard_text_sub"
                android:textSize="12sp"
                tools:text="App: 2.0.0" />
        </LinearLayout>

        <!-- Manifesto Section -->
        <TextView
            android:id="@+id/about_manifesto"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:lineSpacingExtra="6dp"
            android:text="@string/about_manifesto"
            android:textColor="@color/dashboard_text_main"
            android:textSize="15sp" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="32dp"
            android:layout_marginBottom="32dp"
            android:background="@color/table_row_grey" />

        <!-- Donation Section -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif-medium"
            android:text="@string/about_donate_title"
            android:textColor="@color/dashboard_accent_green"
            android:textSize="18sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:layout_marginBottom="24dp"
            android:gravity="center"
            android:text="@string/about_donate_desc"
            android:textColor="@color/dashboard_text_sub"
            android:textSize="14sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:baselineAligned="false"
            android:orientation="horizontal">

            <!-- Alipay -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:orientation="vertical">

                <ImageView
                    android:id="@+id/donate_alipay_qr"
                    android:layout_width="100dp"
                    android:layout_height="100dp"
                    android:background="@drawable/bg_popup_menu"
                    android:elevation="2dp"
                    android:padding="8dp"
                    android:scaleType="fitCenter"
                    android:src="@drawable/donate_alipay" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="@string/donate_alipay_label"
                    android:textColor="@color/dashboard_text_main"
                    android:textSize="12sp" />
            </LinearLayout>

            <!-- WeChat Pay -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:orientation="vertical">

                <ImageView
                    android:id="@+id/donate_wechat_qr"
                    android:layout_width="100dp"
                    android:layout_height="100dp"
                    android:background="@drawable/bg_popup_menu"
                    android:elevation="2dp"
                    android:padding="8dp"
                    android:scaleType="fitCenter"
                    android:src="@drawable/donate_wechat" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="@string/donate_wechat_label"
                    android:textColor="@color/dashboard_text_main"
                    android:textSize="12sp" />
            </LinearLayout>

            <!-- WeChat Friend -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:orientation="vertical">

                <ImageView
                    android:id="@+id/qr_wechat_friend"
                    android:layout_width="100dp"
                    android:layout_height="100dp"
                    android:background="@drawable/bg_popup_menu"
                    android:elevation="2dp"
                    android:padding="8dp"
                    android:scaleType="fitCenter"
                    android:src="@drawable/qr_wechat_friend" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="添加微信"
                    android:textColor="@color/dashboard_text_main"
                    android:textSize="12sp" />
            </LinearLayout>

        </LinearLayout>

        <!-- Easter Egg Indicator (Actual Egg Icon) -->
        <ImageView
            android:id="@+id/easter_egg_indicator"
            android:layout_width="80dp"
            android:layout_height="80dp"
            android:layout_marginTop="16dp"
            android:background="@drawable/bg_popup_menu"
            android:elevation="4dp"
            android:padding="12dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_easter_egg"
            android:visibility="gone" />

        <!-- Nexus Planet Button (Easter Egg) -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/btn_nexus_planet_easter"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:clickable="true"
            android:focusable="true"
            android:foreground="?attr/selectableItemBackground"
            android:visibility="gone"
            app:cardBackgroundColor="@color/dashboard_card_bg"
            app:cardCornerRadius="12dp"
            app:strokeWidth="0dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="16dp">

                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:src="@drawable/ic_settings_planet"
                    app:tint="@color/dashboard_accent_green" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="16dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/planet_nexus"
                        android:textColor="@color/dashboard_text_main"
                        android:textSize="16sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/planet_use_nexus"
                        android:textColor="@color/dashboard_text_sub"
                        android:textSize="12sp" />
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Join Testing Network Button (Easter Egg) -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/btn_join_network_easter"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:clickable="true"
            android:focusable="true"
            android:foreground="?attr/selectableItemBackground"
            android:visibility="gone"
            app:cardBackgroundColor="@color/dashboard_card_bg"
            app:cardCornerRadius="12dp"
            app:strokeWidth="0dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="16dp">

                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:src="@drawable/ic_join_network"
                    app:tint="@color/dashboard_accent_green" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="16dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Join Testing Network"
                        android:textColor="@color/dashboard_text_main"
                        android:textSize="16sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="645ae69a72a847d5"
                        android:textColor="@color/dashboard_text_sub"
                        android:textSize="12sp" />
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Open Source License Link -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="32dp"
            android:gravity="center"
            android:orientation="vertical">

            <TextView
                android:id="@+id/about_license_nexus_gpl"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="?attr/selectableItemBackground"
                android:clickable="true"
                android:focusable="true"
                android:padding="8dp"
                android:text="Zerotier Nexus 开源协议 (GPLv2)"
                android:textColor="@color/dashboard_text_sub"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/about_license_zt_mpl"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="?attr/selectableItemBackground"
                android:clickable="true"
                android:focusable="true"
                android:padding="8dp"
                android:text="ZeroTier 核心协议 (MPLv2)"
                android:textColor="@color/dashboard_text_sub"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/about_license_zt_other"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="?attr/selectableItemBackground"
                android:clickable="true"
                android:focusable="true"
                android:padding="8dp"
                android:text="ZeroTier 附加声明"
                android:textColor="@color/dashboard_text_sub"
                android:textSize="12sp" />
        </LinearLayout>

        <!-- Extra spacing at bottom -->
        <View
            android:layout_width="match_parent"
            android:layout_height="32dp" />

    </LinearLayout>
    </androidx.core.widget.NestedScrollView>
    <com.zerotier.nexus.ui.view.BigEasterEggAnimationView
        android:id="@+id/about_easter_egg_anim"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone" />

</androidx.coordinatorlayout.widget.CoordinatorLayout>
