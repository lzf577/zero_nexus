<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/dashboard_bg"
    android:orientation="vertical"
    android:padding="20dp">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="12dp"
        android:text="@string/input_custom_dns"
        android:textColor="@color/dashboard_text_main"
        android:textSize="14sp" />

    <com.google.android.material.textfield.TextInputLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:boxBackgroundColor="@color/dashboard_card_bg"
        app:boxCornerRadiusBottomEnd="8dp"
        app:boxCornerRadiusBottomStart="8dp"
        app:boxCornerRadiusTopEnd="8dp"
        app:boxCornerRadiusTopStart="8dp"
        app:boxStrokeWidth="0dp"
        app:boxStrokeWidthFocused="1dp"
        app:hintEnabled="false">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/et_dns_servers"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="1.1.1.1\n8.8.8.8"
            android:inputType="textMultiLine"
            android:minLines="2"
            android:gravity="top"
            android:textColor="@color/dashboard_text_main"
            android:textColorHint="@color/dashboard_text_sub" />
    </com.google.android.material.textfield.TextInputLayout>
</LinearLayout>
