<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:padding="24dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_horizontal"
        android:orientation="vertical">

        <!-- Header: Logo & Title -->
        <ImageView
            android:id="@+id/about_logo"
            android:layout_width="64dp"
            android:layout_height="64dp"
            android:layout_marginBottom="12dp"
            android:src="@mipmap/ic_launcher" />

        <TextView
            android:id="@+id/about_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif-medium"
            android:text="@string/about_title"
            android:textColor="@color/dashboard_text_main"
            android:textSize="22sp"
            android:textStyle="bold" />

        <!-- Version Information -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="20dp"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/about_kernel_version"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/dashboard_text_sub"
                android:textSize="12sp"
                tools:text="Kernel: 1.16.2" />

            <View
                android:layout_width="1dp"
                android:layout_height="10dp"
                android:layout_gravity="center_vertical"
                android:layout_marginStart="8dp"
                android:layout_marginEnd="8dp"
                android:background="@color/dashboard_text_sub" />

            <TextView
                android:id="@+id/about_app_version"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/dashboard_text_sub"
                android:textSize="12sp"
                tools:text="App: 2.0.0" />
        </LinearLayout>

        <!-- Manifesto Section -->
        <TextView
            android:id="@+id/about_manifesto"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:lineSpacingExtra="4dp"
            android:text="@string/about_manifesto"
            android:textColor="@color/dashboard_text_main"
            android:textSize="14sp" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="24dp"
            android:layout_marginBottom="24dp"
            android:background="@color/table_row_grey" />

        <!-- Donation Section -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif-medium"
            android:text="@string/about_donate_title"
            android:textColor="@color/dashboard_accent_green"
            android:textSize="18sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="20dp"
            android:gravity="center"
            android:text="@string/about_donate_desc"
            android:textColor="@color/dashboard_text_sub"
            android:textSize="13sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:baselineAligned="false"
            android:orientation="horizontal">

            <!-- Alipay -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:orientation="vertical">

                <ImageView
                    android:id="@+id/donate_alipay_qr"
                    android:layout_width="120dp"
                    android:layout_height="120dp"
                    android:background="@drawable/bg_popup_menu"
                    android:padding="4dp"
                    android:scaleType="fitCenter"
                    android:src="@drawable/donate_alipay"
                    tools:src="@android:drawable/ic_menu_gallery" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="@string/donate_alipay_label"
                    android:textColor="@color/dashboard_text_main"
                    android:textSize="12sp" />
            </LinearLayout>

            <!-- WeChat Pay -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:orientation="vertical">

                <ImageView
                    android:id="@+id/donate_wechat_qr"
                    android:layout_width="120dp"
                    android:layout_height="120dp"
                    android:background="@drawable/bg_popup_menu"
                    android:padding="4dp"
                    android:scaleType="fitCenter"
                    android:src="@drawable/donate_wechat"
                    tools:src="@android:drawable/ic_menu_gallery" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="@string/donate_wechat_label"
                    android:textColor="@color/dashboard_text_main"
                    android:textSize="12sp" />
            </LinearLayout>

        </LinearLayout>

        <!-- Extra spacing at bottom -->
        <View
            android:layout_width="match_parent"
            android:layout_height="16dp" />

    </LinearLayout>
</androidx.core.widget.NestedScrollView>
